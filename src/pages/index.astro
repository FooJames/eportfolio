---
import BaseLayout from "../layouts/BaseLayout.astro";
import { url } from "../lib/url";
import { LINKEDIN_URL, GITHUB_URL } from "../config";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-sm uppercase tracking-widest opacity-60 py-1">Career e-portfolio</div>
    <div class="text-5xl font-bold">James Foo</div>
    <div class="text-2xl py-3 font-semibold">
      Computer Science student seeking a data science or machine learning internship
    </div>
    <div class="py-2 space-y-4 text-lg">
      <p>
        I'm a BS Computer Science student at <b>De La Salle University Manila</b>, majoring in Software Technology
        (expected graduation 2028). I'm drawn to the places where people and data meet: human-computer interaction,
        behavioral data analysis, and applied machine learning.
      </p>
      <p>
        My thesis, <b>StabiliRead</b>, explores gaze-based reading assistance on Android. It has taught me to collect,
        validate, and visualize real user data with Python and Jupyter. I'm looking for an internship where I can apply
        that kind of careful, data-driven work to real problems.
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-4">
      <a class="btn" href={url("/projects")}>See my work</a>
      <a class="btn btn-outline" href={url("/cv")}>Resume</a>
      <a class="btn btn-outline" href={LINKEDIN_URL} target="_blank">LinkedIn</a>
      <a class="btn btn-outline" href={GITHUB_URL} target="_blank">GitHub</a>
    </div>
  </div>
</BaseLayout>
