---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume | James Foo" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Career direction</div>
  </div>

  <div class="mb-10">
    Computer Science undergraduate seeking a data science or machine learning internship, with interests in statistical
    learning and Human-Computer Interaction.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Bachelor of Science in Computer Science, major in Software Technology"
      subtitle="De La Salle University, Manila · Expected graduation 2028"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Project experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="StabiliRead · Undergraduate thesis (in progress)"
      subtitle="Gaze-based reading assistance for Android"
    >
      <ul class="list-disc mx-5 grid gap-1">
        <li>Developed an Android reading prototype that uses gaze estimation to activate four forms of visual assistance.</li>
        <li>Implemented timestamped logging to align gaze samples, reading patterns, and visual-aid interactions within user sessions.</li>
        <li>Built a Python and Jupyter workflow to validate recordings, visualize gaze patterns, and export structured research datasets.</li>
        <li>Examined raw and smoothed gaze trajectories, missing data, and event timing to assess recording quality.</li>
      </ul>
    </TimeLineElement>
    <TimeLineElement
      title="Kabuhayan DB · Backend tester"
      subtitle="Team project for a local government unit"
    >
      <ul class="list-disc mx-5 grid gap-1">
        <li>Performed backend testing for a team-developed database system intended to digitize SKMLHOAI's administrative processes.</li>
        <li>Project scope included member and household records, dues tracking, certification generation, and accreditation autofill.</li>
      </ul>
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Technical skills</div>
  </div>

  <dl class="grid gap-3 mb-10">
    <div><dt class="font-semibold">Programming</dt><dd>Python, R, C, JavaScript</dd></div>
    <div><dt class="font-semibold">Data analysis</dt><dd>Exploratory data analysis, data validation, data visualization</dd></div>
    <div><dt class="font-semibold">Tools and libraries</dt><dd>pandas, NumPy, Matplotlib, Jupyter Notebook</dd></div>
    <div><dt class="font-semibold">Development</dt><dd>Android, Git, Firebase, backend testing</dd></div>
  </dl>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Research interests</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-1">
    <li>Human-Computer Interaction</li>
    <li>Behavioral Data Analysis</li>
    <li>Applied Machine Learning</li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Languages</div>
  </div>

  <div>English, Filipino</div>
</BaseLayout>
