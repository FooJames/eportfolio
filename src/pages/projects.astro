---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { projects } from "../data/projects";
import { samples } from "../data/samples";
import { url } from "../lib/url";
---

<BaseLayout title="Projects | James Foo" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-2">Projects</div>
    <p class="mb-6 opacity-75">Academic work samples. Each card links to its public repository.</p>
  </div>

  {
    projects.map((p, i) => (
      <>
        {i > 0 && <div class="divider my-0" />}
        <HorizontalCard title={p.title} badge={p.badge} desc={p.desc} url={p.url} />
      </>
    ))
  }

  <div class="text-3xl w-full font-bold mt-12 mb-2">Academic work samples</div>
  <p class="mb-6 opacity-75">Reports and presentations from my coursework.</p>
  <ul class="grid gap-4">
    {
      samples.map((s) => (
        <li>
          <div class="font-bold">{s.title}</div>
          <div class="text-sm opacity-75">{s.project}</div>
          <p class="py-1">{s.desc}</p>
          <a class="btn btn-outline btn-sm" href={url(s.file)} target="_blank">View PDF</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
